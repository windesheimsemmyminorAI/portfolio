{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Factuur",
  "description": "Datastructuur van een inkoopfactuur",
  "type": "object",
  "properties": {
    "factuurnummer": { "type": "string" },
    "factuurdatum": { "type": "string", "format": "date" },
    "leverancier_naam": { "type": "string" },
    "bankrekeningnummer": { "type": "string", "description": "IBAN" },
    "totaalbedrag_excl_btw": { "type": "number" },
    "btw_bedrag": { "type": "number" },
    "totaalbedrag_incl_btw": { "type": "number" },
    "regels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "omschrijving": { "type": "string" },
          "aantal": { "type": "number" },
          "stukprijs": { "type": "number" },
          "projectnummer": { "type": "string" }
        },
        "required": ["omschrijving", "aantal", "stukprijs"]
      }
    }
  },
  "required": ["factuurnummer", "factuurdatum", "leverancier_naam", "totaalbedrag_incl_btw"]
}
